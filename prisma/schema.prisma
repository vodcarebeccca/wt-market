generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Product {
  id         String      @id @default(cuid())
  slug       String      @unique
  titleId    String
  titleEn    String
  descId     String
  descEn     String
  minLevel   Int?
  maxLevel   Int?
  minRank    Int?
  maxRank    Int?
  nation     String?
  category   String
  priceIdr   Int
  imageUrl   String?
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  stockItems StockItem[]
  orderItems OrderItem[]
  reviews    Review[]
}

model StockItem {
  id          String     @id @default(cuid())
  productId   String
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  credential  String
  status      String     @default("AVAILABLE")
  orderItemId String?    @unique
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])
  createdAt   DateTime   @default(now())
  soldAt      DateTime?

  @@index([productId, status])
}

model Order {
  id                String      @id @default(cuid())
  code              String      @unique
  accessToken       String      @unique
  buyerEmail        String?
  buyerWhatsapp     String?
  locale            String      @default("id")
  status            String      @default("PENDING")
  totalIdr          Int
  adminNote         String?
  midtransOrderId   String?     @unique
  midtransSnapToken String?
  paidAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items             OrderItem[]
  payments          Payment[]
  reviews           Review[]
}

model OrderItem {
  id           String     @id @default(cuid())
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  productTitle String
  unitPriceIdr Int
  quantity     Int        @default(1)
  stockItem    StockItem?
}

model Payment {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        String
  providerRef     String?
  amountIdr       Int
  status          String
  rawNotification String?
  createdAt       DateTime @default(now())
}

model Review {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerEmail  String?
  rating      Int
  comment     String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId, status])
}

model DiscountCode {
  id              String   @id @default(cuid())
  code            String   @unique
  type            String   @default("PERCENT")
  value           Int
  minPurchaseIdr  Int      @default(0)
  maxDiscountIdr  Int?
  usageLimit      Int      @default(0)
  usedCount       Int      @default(0)
  isActive        Boolean  @default(true)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
